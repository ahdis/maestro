<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.ihe.gazelle</groupId>
        <artifactId>parent-bom</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>maestro</artifactId>
    <version>0.2.0-GZL-9816-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>maestro-api</module>
        <module>maestro-engine</module>
        <module>maestro-step</module>
        <module>maestro-quarkus</module>
    </modules>

    <scm>
        <connection>scm:git:${git.project.url}</connection>
        <url>scm:git:${git.project.url}</url>
        <developerConnection>scm:git:${git.project.url}</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <framework.version>2.1.0</framework.version>
        <search-api.version>1.1.0</search-api.version>
        <validation-api.version>2.0.0-FRAME-74-SNAPSHOT</validation-api.version>
        <simulation-api.version>0.1.0</simulation-api.version>
        <service-registry.version>1.0.0</service-registry.version>
        <lang.version>2.0.1</lang.version>
        <equalsverifier.version>3.16.1</equalsverifier.version>

        <!-- Quarkus Build-->
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.15.5</quarkus.platform.version>
        <quarkus.container-image.build>true</quarkus.container-image.build>
        <quarkus.container-image.registry>rg.fr-par.scw.cloud</quarkus.container-image.registry>
        <quarkus.container-image.group>gazelle-snapshot</quarkus.container-image.group>
        <quarkus.container-image.name>app/maestro</quarkus.container-image.name>
        <quarkus.container-image.tag>${project.version}</quarkus.container-image.tag>

        <!-- Plugins version -->
        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.3</surefire-plugin.version>
        <maven.failsafe.plugin.version>3.1.2</maven.failsafe.plugin.version>
        <jacoco-maven-plugin.version>0.8.11</jacoco-maven-plugin.version>
        <bulild.helper.maven.plugin.version>3.6.1</bulild.helper.maven.plugin.version>
        <release-plugin.version>3.1.1</release-plugin.version>
        <pitest.maven.version>1.18.2</pitest.maven.version>
        <jandex-plugin.version>3.1.6</jandex-plugin.version>

        <skipTests>false</skipTests>
        <skipITs>${skipTests}</skipITs>
        <skipUnitTests>${skipTests}</skipUnitTests>

        <!--git-->
        <git.user.name>gitlab-ci</git.user.name>
        <git.user.token>changeit</git.user.token>
        <git.project.url>
            https://${git.user.name}:${git.user.token}@gitlab.inria.fr/gazelle/private/kereval/maestro.git
        </git.project.url>

        <sonar.coverage.exclusions>
            **/gazelle/business/engine/NotInitializedReferenceException.java,
            **/gazelle/business/step/NotProvidedStep.java,
            **/gazelle/business/validation/DuplicatedStepsException.java,
            **/gazelle/business/validation/InvalidTestRunException.java,
            **/gazelle/technical/ws/MissingArgumentException.java,
            **/gazelle/technical/ws/ParsingErrorException.java,
            **/gazelle/context/*
            **/gazelle/maestro/technical/ws/async/tmintegration/**
        </sonar.coverage.exclusions>
        <datahouse.version>3.0.1-GZL-9816-SNAPSHOT</datahouse.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Simulation service API sub-modules dependencies -->
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>maestro-api</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>maestro-engine</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>validation-step</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>simulation-step</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>user-interaction-step</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>assertion-step</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>itb-step</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>
            <!-- to be removed when maestro-websocket has it own tests -->
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>maestro-websocket</artifactId>
                <version>0.2.0-GZL-9816-SNAPSHOT</version>
            </dependency>

            <!-- Stack BOM -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Gazelle dependencies -->
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>framework</artifactId>
                <version>${framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <artifactId>validation-service-api</artifactId>
                <groupId>net.ihe.gazelle</groupId>
                <version>${validation-api.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>simulation-service-api</artifactId>
                <version>${simulation-api.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>search-api</artifactId>
                <version>${search-api.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>service-registry-client</artifactId>
                <version>${service-registry.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ihe.gazelle</groupId>
                <artifactId>lang</artifactId>
                <version>${lang.version}</version>
            </dependency>
            <dependency>
                <groupId>com.kereval.gazelle</groupId>
                <artifactId>datahouse-microprofile-rest-client</artifactId>
                <version>${datahouse.version}</version>
            </dependency>


            <!-- Test dependencies -->
            <dependency>
                <groupId>nl.jqno.equalsverifier</groupId>
                <artifactId>equalsverifier</artifactId>
                <version>${equalsverifier.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <skipTests>${skipUnitTests}</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.failsafe.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <skipITs>${skipITs}</skipITs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>pre-unit-test</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>post-unit-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- add src/it/java as test sources -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${bulild.helper.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>add-test-source</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/it/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-integration-test-resources</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>add-test-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>src/it/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>${release-plugin.version}</version>
                <configuration>
                    <tagNameFormat>@{project.version}</tagNameFormat>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <releaseProfiles>release</releaseProfiles>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.maven.version}</version>
                <!-- Pitest needs specific dependency for Junit5-->
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>${jandex-plugin.version}</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>IHE</id>
            <name>IHE Public Maven Repository Group</name>
            <url>https://nexus.ihe-catalyst.net/repository/maven-public/</url>
            <layout>default</layout>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>IHE-plugins</id>
            <name>IHE Plugins Public Maven Repository Group</name>
            <url>https://nexus.ihe-catalyst.net/repository/maven-public/</url>
            <layout>default</layout>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <organization>
        <name>Kereval</name>
        <url>https://www.kereval.com</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <contributors>
        <contributor>
            <organization>IHE Catalyst</organization>
            <organizationUrl>https://ihe-catalyst.net</organizationUrl>
        </contributor>
        <contributor>
            <organization>Kereval</organization>
            <organizationUrl>https://www.kereval.com</organizationUrl>
        </contributor>
        <contributor>
            <organization>E-Health-Suisse</organization>
            <organizationUrl>https://www.e-health-suisse.ch</organizationUrl>
        </contributor>
    </contributors>

    <profiles>
        <profile>
            <id>with-websocket</id>
            <activation>
                <property>
                    <name>websocket</name>
                </property>
            </activation>
            <modules>
                <module>maestro-api</module>
                <module>maestro-engine</module>
                <module>maestro-step</module>
                <module>maestro-quarkus</module>
                <module>maestro-websocket</module>
            </modules>
        </profile>
        <profile>
            <id>with-mlang</id>
            <activation>
                <property>
                    <name>mlang</name>
                </property>
            </activation>
            <modules>
                <module>maestro-api</module>
                <module>maestro-engine</module>
                <module>maestro-step</module>
                <module>mlang-converter</module>
                <module>maestro-quarkus</module>
            </modules>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>net.ihe.gazelle</groupId>
                        <artifactId>mlang-converter</artifactId>
                        <version>0.2.0-GZL-9816-SNAPSHOT</version>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>
    </profiles>

</project>
